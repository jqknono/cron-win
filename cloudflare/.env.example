# Cloudflare API 配置
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# 部署环境
NODE_ENV=production

# 可选：自定义域名
DOMAIN_PRIMARY=cronwin.techfetch.dev
DOMAIN_ALTERNATIVES=wincron.techfetch.dev,taskscheduler.techfetch.dev

# 可选：Worker 配置
WORKER_NAME=cronwin-worker
WORKER_ENVIRONMENT=production